APP_NAME="KPI NUKKU"
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://kpi.example.ac.th

APP_LOCALE=th
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=th_TH

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=warning

DB_CONNECTION=pgsql
DB_HOST=db
DB_PORT=5432
DB_DATABASE=kpi_nukku
DB_USERNAME=kpi_nukku
DB_PASSWORD=CHANGE_ME_DB_PASSWORD

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null
SESSION_SECURE_COOKIE=true
SESSION_SAME_SITE=lax

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=redis
REDIS_PASSWORD=CHANGE_ME_REDIS_PASSWORD
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

# To use KKU Mail API as the primary mailer, set:
# MAIL_MAILER=kku
# MAIL_FROM_ADDRESS=no_reply@kku.ac.th
# MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# --- KKU SSO ---
SSO_APP_ID=
SSO_CLIENT_ID=
SSO_CLIENT_SECRET=
SSO_REDIRECT_URL=https://kpi.example.ac.th/auth
SSO_WEB_BASE_URL=https://sso.example.ac.th
SSO_API_BASE_URL=https://sso-api.example.ac.th

# Notifications: send reminders to all users (not only assignees)
# Set to true to broadcast to all emails in users table
# REMINDER_SEND_TO_ALL=false

# --- KKU API ---
KKU_API_BASE=https://api.kku.ac.th/v3
KKU_CLIENT_ID=
KKU_SECRET_KEY=
# Optional: override default token TTL (minutes); default is ~23h
# KKU_TOKEN_TTL_MINUTES=1380
